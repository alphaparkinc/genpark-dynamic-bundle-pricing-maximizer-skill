{
  "name": "genpark-dynamic-bundle-pricing-maximizer-skill",
  "version": "1.0.0",
  "description": "GenPark AI Agent Skill - Dynamic cross-category e-commerce product bundle pricing optimizer maximizing Average Order Value (AOV) and conversion margin curves.",
  "homepage": "https://genpark.ai/mcp",
  "author": "alphaparkinc",
  "category": "pricing-intelligence",
  "tags": [
    "bundle-pricing",
    "aov-optimization",
